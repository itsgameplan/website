# Copy to .env.local for local development; set the same variables in Render for production.

# PostgreSQL that stores form messages and admin accounts
# (hosted databases usually need ?sslmode=require on the end)
DATABASE_URL=postgres://postgres:password@localhost:5432/gameplan
# optional: max connections the site opens (default 5)
# DATABASE_POOL_MAX=5

# Better Auth: a long random secret (e.g. `openssl rand -base64 32`) and the site's URL
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# First admin, created (or password reset) by `npm run db:setup`
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Web3Forms access key: also emails every form message to marketing@itsgameplan.com
NEXT_PUBLIC_WEB3FORMS_KEY=
